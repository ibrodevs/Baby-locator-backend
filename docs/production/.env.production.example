# TEMPLATE ONLY. Replace placeholders; never commit the real file.
# systemd: /etc/baby-locator/backend.env (owner baby-locator, chmod 600).
# Prevent a stale checkout .env from supplying missing production variables.
PYTHON_DOTENV_DISABLED=1
DJANGO_SECRET_KEY=<RANDOM_UNIQUE_SECRET_AT_LEAST_50_CHARACTERS>
DJANGO_DEBUG=False
IS_TEST=False
DJANGO_ALLOWED_HOSTS=<YOUR_API_HOST>
DJANGO_DB_ENGINE=django.db.backends.postgresql
DJANGO_DB_NAME=babydb
DJANGO_DB_USER=babyuser
DJANGO_DB_PASSWORD=<RANDOM_DATABASE_PASSWORD>
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=5432
DJANGO_CORS_ALLOW_ALL_ORIGINS=False
DJANGO_CORS_ALLOWED_ORIGINS=https://<YOUR_WEB_HOST>
DJANGO_CSRF_TRUSTED_ORIGINS=https://<YOUR_API_HOST>
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
# Private Redis, no public port, protected with password/ACL in production.
REDIS_URL=redis://:<REDIS_PASSWORD>@127.0.0.1:6379/1
LIVE_AUDIO_REDIS_URL=redis://:<REDIS_PASSWORD>@127.0.0.1:6379/2
FIREBASE_SERVICE_ACCOUNT_KEY=/etc/baby-locator/firebase-admin.json
FIREBASE_EXPECTED_PROJECT_ID=kid-security-994a0
# Public Android Maps key: restrict Android package + Play App Signing SHA-1.
GOOGLE_MAPS_ANDROID_API_KEY=<ANDROID_MAPS_PUBLIC_KEY>
# Optional separate server-only Geocoding API key, restricted by server IP/API.
# Empty means reverse geocoding unavailable; GPS coordinates still work.
GOOGLE_GEOCODING_API_KEY=
# Android public SDK key from the matching RevenueCat Android app.
REVENUECAT_PUBLIC_API_KEY_ANDROID=goog_<YOUR_PUBLIC_ANDROID_KEY>
# Leave empty until a separate iOS app is configured; never reuse goog_ on iOS.
REVENUECAT_PUBLIC_API_KEY_IOS=
# Server-only RevenueCat API v1 key with subscriber read/delete permissions.
REVENUECAT_SECRET_API_KEY=<YOUR_REVENUECAT_SECRET_SERVER_KEY>
REVENUECAT_APP_IDS=<REVENUECAT_APP_ID_FROM_WEBHOOK_app_id>
REVENUECAT_ALLOWED_ENVIRONMENTS=PRODUCTION
REVENUECAT_ENTITLEMENT_ID=family_security_pro
# Exact identifiers from your actual catalog, NOT guessed names.
REVENUECAT_PREMIUM_PRODUCT_IDS=<PRODUCT_IDS_COMMA_SEPARATED>
REVENUECAT_LIFETIME_PRODUCT_IDS=
REVENUECAT_WEBHOOK_AUTH_HEADER=Bearer <INDEPENDENT_RANDOM_WEBHOOK_SECRET>
WEBRTC_STUN_URLS=stun:<YOUR_TURN_HOST>:3478
WEBRTC_TURN_URLS=turn:<YOUR_TURN_HOST>:3478?transport=udp,turn:<YOUR_TURN_HOST>:3478?transport=tcp,turns:<YOUR_TURN_HOST>:5349?transport=tcp
WEBRTC_TURN_SECRET=<SHARED_SECRET_MATCHING_COTURN>
WEBRTC_TURN_TTL_SECONDS=3600
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
